[Unit]
Description=llama.cpp control panel
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
Environment=HOME=__HOME__
Environment=PYTHONUNBUFFERED=1
ExecStart=__PYTHON__ -m llamactl --host __HOST__ --port __PORT__ --llama-port __LLAMA_PORT__

# SIGTERM goes to the controller only, so it can shut its llama-server children
# down cleanly; anything still alive after the timeout is killed with the group.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90

# A model that gets OOM-killed is one model failing, not the controller failing.
# Without this systemd stops the whole unit and every other model goes with it.
OOMPolicy=continue

# Cap the models at a share of RAM so an over-committed start is contained here
# instead of taking the whole machine down — on a box without swap, a global OOM
# can hang or reboot it. The kernel kills inside this cgroup first.
MemoryMax=85%
MemoryHigh=78%

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
